{
  "name": "finsight-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "start:all": "npm run dev:backend & npm run dev:frontend"
  }
}
